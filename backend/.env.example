# ===== Django =====
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Vergul bilan ajratilgan hostlar. Production'da real domen(lar)ni yozing.
ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx
# CORS — mobil ilova uchun odatda kerak emas, lekin lokal test uchun
CORS_ALLOW_ALL_ORIGINS=True

# ===== PostgreSQL =====
POSTGRES_DB=securetest
POSTGRES_USER=securetest
POSTGRES_PASSWORD=securetest_pass_change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== JWT (daqiqalarda) =====
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ===== Superuser (entrypoint avtomatik yaratadi, bo'sh qoldirsa yaratmaydi) =====
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
